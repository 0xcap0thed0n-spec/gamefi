# Copy to apps/web/.env.local - never commit real secrets

# Public app config (safe to expose in the browser)
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain Testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_PACK_CONTRACT_ADDRESS=

# --- Server-only below this line. NEVER prefix with NEXT_PUBLIC_, NEVER commit real values. ---

# Shared secret for /admin gate (see middleware.ts)
ADMIN_PASSWORD=

# --- X / Twitter OAuth 2.0 (PKCE) ---
# Create app at https://developer.x.com
# Enable OAuth 2.0 + PKCE; callback must match TWITTER_CALLBACK_URL
# Scopes for connect-only: tweet.read users.read offline.access
# (follows.read / like.read only needed if you later enable verify checklist)
TWITTER_CLIENT_ID=
# Optional for confidential clients
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:3000/api/twitter/callback
# Optional cookie encryption secret
TWITTER_SESSION_SECRET=
